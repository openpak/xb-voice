# xb-voice configuration. No secrets in this file: every secret is a file under /run/xb.

# gRPC/mTLS listener for the gateway's feature streams (service id 6, xmatch).
XB_FEATURE_ADDR=0.0.0.0:26117
# Loopback health listener inside the container.
XB_LISTEN_ADDR=127.0.0.1:26118
XB_TLS_CERT_FILE=/run/xb/server.crt
XB_TLS_KEY_FILE=/run/xb/server.key
# Dedicated CA that signs the gateway's client certificate (URI SAN spiffe://openpak/xb-gateway).
XB_CLIENT_CA_FILE=/run/xb/client-ca.crt

# The neutral voice service (github.com/openpak/voice), gRPC. The key names this adapter: it is
# the "xbox" entry of the voice service's VOICE_ADAPTER_KEYS.
XB_VOICE_ADDR=openpak-voice:20161
XB_VOICE_KEY_FILE=/run/xb/voice.key
XB_VOICE_PLAINTEXT_INTERNAL=1
# or: XB_VOICE_CA_FILE=/run/xb/voice-ca.crt  XB_VOICE_SERVER_NAME=...

# How long a session stays resolvable without any message from its host or a joiner (default 2h).
# XB_VOICE_SESSION_TTL=2h
# Log each xmatch request body as hex with the console-identifying bytes zeroed (bring-up only).
# XB_VOICE_DEBUG_REQUESTS=1
